# ─── Clinical Ledger Hospital Management System — Environment Template ───

# Supabase PostgreSQL Connection String (Transaction Pooler, Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Alternatively, you can use SUPABASE_DATABASE_URL
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Direct connection for migrations (Port 5432)
# SUPABASE_MIGRATION_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Secret used to sign session JWT tokens (min 32 characters)
JWT_SECRET=your-32-character-random-secret-key-here

# Node environment (do NOT set here — Vercel sets this automatically)
# NODE_ENV=production

# Server port
PORT=3000

# Vite App ID
VITE_APP_ID=clinical-ledger

# Optional: OAuth Provider
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional: AWS S3 Document Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional: Built-in Forge / LLM Service
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
